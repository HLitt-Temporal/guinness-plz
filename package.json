{
  "name": "guinness-plz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentic Guinness 8-pack research with round-trip fuel costs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --watch-path=server.ts --watch-path=workflow.ts --watch-path=research.ts --watch-path=headless-maps.ts --watch-path=price-check.ts --watch-path=price-page.ts --watch-path=temporal server.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node server.ts",
    "worker": "node temporal/worker.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@openai/agents-core": "0.14.3",
    "@openai/agents-openai": "0.14.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.57.2",
    "@opentelemetry/context-async-hooks": "1.30.1",
    "@opentelemetry/core": "1.30.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.57.2",
    "@opentelemetry/exporter-trace-otlp-proto": "0.57.2",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-logs": "0.57.2",
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/interceptors-opentelemetry": "1.24.0",
    "@temporalio/openai-agents": "1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@temporalio/workflow-streams": "1.24.0",
    "openai": "^6.49.0",
    "playwright": "^1.58.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@temporalio/testing": "1.24.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
