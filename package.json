{
  "name": "guinness-plz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentic Guinness 8-pack research with round-trip fuel costs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --watch-path=server.ts --watch-path=workflow.ts --watch-path=headless-maps.ts server.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node server.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "playwright": "^1.58.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
