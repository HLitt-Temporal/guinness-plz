# Copy to .env and set your OpenAI key to enable live research.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Location and driving distances use headless Chromium; no Maps API key.
PORT=8765
# Live searches run as Temporal Cloud workflows. Use the namespace's regional
# gRPC endpoint and an API key with write access to the namespace.
TEMPORAL_ADDRESS=us-east-1.aws.api.temporal.io:7233
TEMPORAL_NAMESPACE=guinness-plz.your-account-id
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE=guinness-plz
# Traces, logs, and metrics for Grafana. In Grafana Cloud, open your stack's
# OpenTelemetry (OTLP) page and generate a token. Copy the endpoint and the
# headers line it shows. Leave the endpoint blank to send nothing.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Example: Authorization=Basic%20<base64 of instance-id:token>
OTEL_EXPORTER_OTLP_HEADERS=
